# OpenLinear needs no environment file. These local-only overrides are optional.
OPENLINEAR_DATA_DIR=
OPENLINEAR_PORT=4174

# Only literal loopback addresses are accepted. Any remote bind fails closed.
OPENLINEAR_HOST=127.0.0.1

# Optional process-memory session lifetime, from 300 to 86400 seconds.
OPENLINEAR_SESSION_TTL_SECONDS=43200

# Optional immutable label included in canonical transfer metadata.
OPENLINEAR_BUILD_ID=0.1.0-local
