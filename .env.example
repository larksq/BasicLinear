# OpenLinear local mode needs no environment file. These local-only overrides are optional.
OPENLINEAR_DATA_DIR=
OPENLINEAR_PORT=4174

# Only literal loopback addresses are accepted. Any remote bind fails closed.
OPENLINEAR_HOST=127.0.0.1

# Optional process-memory session lifetime, from 300 to 86400 seconds.
OPENLINEAR_SESSION_TTL_SECONDS=43200

# Optional immutable label included in canonical transfer metadata.
OPENLINEAR_BUILD_ID=0.1.0-local

# OpenLinear Online public Firebase web configuration. These identify the Firebase project;
# they are not service-account credentials. Supply them only to the hosted Vite build.
VITE_OPENLINEAR_DEPLOYMENT_ENVIRONMENT=development
VITE_OPENLINEAR_PROVIDER_STATUS=configuring
VITE_OPENLINEAR_DEVELOPMENT_FIREBASE_PROJECT_ID=openlinear-dev-larksq
VITE_OPENLINEAR_PRODUCTION_FIREBASE_PROJECT_ID=openlinear-prod-larksq
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional hosted browser emulator. Only a loopback HTTP origin is accepted.
VITE_FIREBASE_AUTH_EMULATOR_URL=
# Example: http://127.0.0.1:9099

# Hosted trusted-service configuration. Cloud Run supplies PORT and Application Default
# Credentials. List every deployment-owned browser origin exactly (scheme, host, and port);
# non-loopback HTTP is rejected. Do not put a service-account private key in this file.
PORT=8080
OPENLINEAR_DEPLOYMENT_ENVIRONMENT=development
OPENLINEAR_DEVELOPMENT_FIREBASE_PROJECT_ID=openlinear-dev-larksq
OPENLINEAR_PRODUCTION_FIREBASE_PROJECT_ID=openlinear-prod-larksq
OPENLINEAR_FIREBASE_PROJECT_ID=openlinear-dev-larksq
OPENLINEAR_FIRESTORE_DATABASE_ID='(default)'
OPENLINEAR_HOSTED_ORIGINS=
# Example: https://PROJECT_ID.web.app,https://online.example.com

# Required trusted-service HMAC secret for retry-safe invitation links. Use at least
# 32 random bytes from Secret Manager. Never expose it through VITE_ variables.
OPENLINEAR_INVITATION_SECRET=

# Required separate trusted-service HMAC secret for collaboration idempotency records.
# Use at least 32 random bytes from Secret Manager; never expose it through VITE_ variables.
OPENLINEAR_COLLABORATION_SECRET=

# Required separate trusted-service HMAC secret for personal-token digests and
# signed token lifecycle records. Use at least 32 random bytes from Secret Manager.
OPENLINEAR_PERSONAL_TOKEN_SECRET=

# Required separate trusted-service HMAC secret for hosted project/milestone
# idempotency and audit records. Use at least 32 random bytes from Secret Manager.
OPENLINEAR_PM_SECRET=

# Required separate trusted-service HMAC secret for opaque REST pagination cursors.
# Rotating it invalidates outstanding cursors but does not affect stored product data.
OPENLINEAR_REST_CURSOR_SECRET=

# Required separate trusted-service HMAC secret for MCP OAuth grants, opaque access and
# rotating refresh-token families. REST personal tokens are never accepted by /mcp.
OPENLINEAR_MCP_OAUTH_SECRET=

# Required separate trusted-service HMAC secret for hosted rate controls, budget
# signal ledgers, billing-activation evidence, cost reports, and restore drills.
OPENLINEAR_OPERATIONS_SECRET=

# Exact hosted control environment. Paid Checkout remains fail-closed until the
# matching signed operations activation and fresh budget state exist server-side.
OPENLINEAR_HOSTED_ENVIRONMENT=uat

# Authenticated Pub/Sub push identity for Google Cloud Billing budget status.
# The audience must be the exact HTTPS (or loopback test) endpoint shown below;
# the service-account identity and audience claims are both signature-verified.
OPENLINEAR_BUDGET_PUSH_AUDIENCE=
# Example: https://online.example.com/api/v1/hosted/operations/budget-notice
OPENLINEAR_BUDGET_PUSH_SERVICE_ACCOUNT=

# Required separate trusted-service HMAC secret for billing, checkout, and webhook
# lifecycle records. Use at least 32 random bytes from Secret Manager.
OPENLINEAR_BILLING_SECRET=

# Payment provider boundary. Use creem (or stripe) for provider-backed Checkout. The explicit
# verification mode disables provider calls and requires a server-side exact email
# allowlist; allowlisted workspaces receive a signed no-charge grant through year 9999.
OPENLINEAR_PAYMENT_MODE=stripe
OPENLINEAR_VERIFICATION_ACCESS_EMAILS=

# Stripe values are trusted-service secrets/references and must never use VITE_ names.
# CT-138 does not provide live values or activate billing. Create the two recurring USD
# prices in the deployment-owned Stripe account only after the later release gates.
OPENLINEAR_STRIPE_SECRET=
OPENLINEAR_STRIPE_WEBHOOK_SECRET=
OPENLINEAR_STRIPE_MONTHLY_PRICE_ID=
OPENLINEAR_STRIPE_ANNUAL_PRICE_ID=

# Creem values are trusted-service settings and must never use VITE_ names.
# Development requires creem_test_ credentials; production requires live credentials.
# Products: recurring USD $2/seat/month and $12/seat/year; distinct product IDs.
# Webhook path: /api/v1/hosted/billing/creem/webhook
OPENLINEAR_CREEM_API_KEY=
OPENLINEAR_CREEM_WEBHOOK_SECRET=
OPENLINEAR_CREEM_MONTHLY_PRODUCT_ID=
OPENLINEAR_CREEM_ANNUAL_PRODUCT_ID=

# One canonical browser origin used for provider Checkout returns. It must
# also appear exactly in OPENLINEAR_HOSTED_ORIGINS. Public HTTP is rejected.
OPENLINEAR_HOSTED_PUBLIC_ORIGIN=

# Optional Firebase Emulator Suite bindings for the trusted service.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
GCLOUD_PROJECT=

# Optional public GitHub repository link on the OpenLinear homepage.
# Set at web build time after the source repository has been published.
# VITE_OPENLINEAR_REPOSITORY_URL=https://github.com/larksq/openlinear
