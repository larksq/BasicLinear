{
  "schemaVersion": "basiclinear.google-cloud-budget.v1",
  "evidenceBoundary": "template_not_applied",
  "budget": {
    "displayName": "BasicLinear pilot budget",
    "budgetFilter": {"projects": ["projects/${GOOGLE_CLOUD_PROJECT_NUMBER}"]},
    "amount": {"specifiedAmount": {"currencyCode": "USD", "units": "25"}},
    "thresholdRules": [
      {"thresholdPercent": 0.5, "spendBasis": "CURRENT_SPEND"},
      {"thresholdPercent": 0.8, "spendBasis": "CURRENT_SPEND"},
      {"thresholdPercent": 1, "spendBasis": "CURRENT_SPEND"}
    ],
    "allUpdatesRule": {
      "pubsubTopic": "projects/${GOOGLE_CLOUD_PROJECT}/topics/openlinear-budget-alerts",
      "schemaVersion": "1.0"
    }
  },
  "pushSubscription": {
    "name": "projects/${GOOGLE_CLOUD_PROJECT}/subscriptions/openlinear-budget-push",
    "topic": "projects/${GOOGLE_CLOUD_PROJECT}/topics/openlinear-budget-alerts",
    "pushConfig": {
      "pushEndpoint": "${BASICLINEAR_BUDGET_PUSH_AUDIENCE}",
      "oidcToken": {
        "serviceAccountEmail": "${BASICLINEAR_BUDGET_PUSH_SERVICE_ACCOUNT}",
        "audience": "${BASICLINEAR_BUDGET_PUSH_AUDIENCE}"
      }
    },
    "retryPolicy": {"minimumBackoff": "10s", "maximumBackoff": "600s"}
  }
}
