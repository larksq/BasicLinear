{
  "schema_version": "public-release-policy-v1",
  "issue": "CT-13",
  "test": "P-T22",
  "ignored_roots": [
    ".git",
    ".control-tower",
    ".playwright-mcp",
    ".vercel",
    ".firebase",
    ".local-data",
    "outputs",
    "node_modules",
    "dist",
    "build",
    "coverage",
    "backups"
  ],
  "ignored_file_names": [".DS_Store", "firestore-debug.log"],
  "ignored_paths": [
    "docs/product/versions/v0.1.0/50-outcome-review/CT-13/preflight-result.json",
    "docs/product/versions/v0.1.0/50-outcome-review/CT-13/result.json"
  ],
  "source_digest_exclusions": [
    "ops/release/asset-provenance.json",
    "ops/release/copy-provenance.json",
    "ops/release/review-request.json",
    "ops/release/review-acceptance.json",
    "docs/product/versions/v0.1.0/10-discovery/CT-3/qualified-review-request.json",
    "docs/product/versions/v0.1.0/10-discovery/CT-3/qualified-review-acceptance.json"
  ],
  "private_file_suffixes": [
    ".db",
    ".sqlite",
    ".sqlite3",
    ".pem",
    ".key",
    ".p12",
    ".pfx"
  ],
  "required_public_documents": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "required_manifests": [
    "ops/release/asset-provenance.json",
    "ops/release/copy-provenance.json",
    "ops/release/review-acceptance.json"
  ],
  "review_request_manifest": "ops/release/review-request.json",
  "qualified_identity_review": {
    "request_manifest": "docs/product/versions/v0.1.0/10-discovery/CT-3/qualified-review-request.json",
    "acceptance_manifest": "docs/product/versions/v0.1.0/10-discovery/CT-3/qualified-review-acceptance.json",
    "required_sponsor_decision": {
      "license": "AGPL-3.0-only",
      "project_identity": "Scopefold",
      "requested_final_product_brand": "OpenLinear"
    },
    "accepted_identity_patterns": ["OpenLinear", "openlinear", "@openlinear/"],
    "evidence_documents": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "docs/product/versions/v0.1.0/10-discovery/CT-3/decision-record.md",
      "docs/product/versions/v0.1.0/10-discovery/CT-3/license-comparison.md",
      "docs/product/versions/v0.1.0/10-discovery/CT-3/clean-room-policy.md",
      "docs/product/versions/v0.1.0/10-discovery/CT-3/name-screen.md",
      "docs/product/versions/v0.1.0/10-discovery/CT-3/source-register.json",
      "docs/product/versions/v0.1.0/10-discovery/CT-3/evidence.md",
      "docs/product/versions/v0.1.0/10-discovery/CT-3/qualified-review-guide.md",
      "ops/release/dependency-license-inventory.json",
      "ops/release/third-party-notices.json",
      "ops/release/asset-provenance.json",
      "ops/release/copy-provenance.json"
    ]
  },
  "decision_result": "docs/product/versions/v0.1.0/10-discovery/CT-3/result.json",
  "dependency_inventory": "ops/release/dependency-license-inventory.json",
  "third_party_notices_manifest": "ops/release/third-party-notices.json",
  "testing_result": "docs/product/versions/v0.1.0/40-testing/CT-12/result.json",
  "build_manifest": "ops/release/reproducible-build.json",
  "working_identity_patterns": ["OpenLinear", "openlinear", "@openlinear/"],
  "identity_scan_roots": [
    ".env.example",
    "README.md",
    "package.json",
    "package-lock.json",
    "apps",
    "packages",
    "ops/cli",
    "docs/operations"
  ],
  "asset_extensions": [
    ".gif",
    ".ico",
    ".jpeg",
    ".jpg",
    ".png",
    ".svg",
    ".ttf",
    ".webp",
    ".woff",
    ".woff2"
  ],
  "public_copy_roots": ["apps/web/index.html", "apps/web/hosted.html", "apps/web/src", "apps/web/public/mcp-guide.html"],
  "ignore_contract": {
    ".gitignore": [".control-tower/", ".env", ".env.*", ".playwright-mcp/", "/backups/"]
  }
}
