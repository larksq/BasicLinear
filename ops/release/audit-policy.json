{
  "schema_version": "public-release-policy-v2",
  "release": "BasicLinear open-source release",
  "ignored_roots": [
    ".git",
    ".control-tower",
    ".playwright-mcp",
    ".vercel",
    ".firebase",
    ".local-data",
    "outputs",
    "node_modules",
    "dist",
    "build",
    "coverage",
    "backups"
  ],
  "ignored_file_names": [".DS_Store", "firestore-debug.log"],
  "ignored_paths": [
    "docs/product/versions/v0.1.0/50-outcome-review/CT-13/preflight-result.json",
    "docs/product/versions/v0.1.0/50-outcome-review/CT-13/result.json"
  ],
  "source_digest_exclusions": [
    "ops/release/asset-provenance.json",
    "ops/release/copy-provenance.json"
  ],
  "private_file_suffixes": [
    ".db",
    ".sqlite",
    ".sqlite3",
    ".pem",
    ".key",
    ".p12",
    ".pfx"
  ],
  "required_public_documents": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "required_manifests": [
    "ops/release/asset-provenance.json",
    "ops/release/copy-provenance.json"
  ],
  "public_identity": {
    "name": "BasicLinear",
    "package_scope": "@basiclinear/",
    "public_origin": "https://basiclinear.qiaosun.me"
  },
  "identity_anchors": [
    {"path": "package.json", "contains": "\"name\": \"basiclinear\""},
    {"path": "README.md", "contains": "# BasicLinear"},
    {"path": "apps/web/src/homepage.tsx", "contains": "BasicLinear"},
    {"path": "apps/web/src/ai-mcp-guide.tsx", "contains": "https://basiclinear.qiaosun.me/mcp"},
    {"path": "apps/web/public/basiclinear-analytics.js", "contains": "basiclinear.qiaosun.me"}
  ],
  "legacy_identity_patterns": ["OpenLinear", "openlinear", "@openlinear/", "Scopefold", "scopefold"],
  "identity_scan_roots": [
    "README.md",
    "package.json",
    "package-lock.json",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "apps/api/src",
    "apps/hosted-service/src",
    "apps/web/src",
    "apps/web/public",
    "packages",
    "ops/cli",
    "docs/README.md",
    "docs/architecture.md",
    "docs/configuration.md",
    "docs/status.md",
    "docs/operations",
    "docs/marketing",
    "pmo",
    "prototypes",
    "skills",
    "scripts"
  ],
  "identity_scan_exclusions": [
    "ops/release/audit-policy.json",
    "scripts/tests/audit-public-release.test.mjs",
    "scripts/tests/audit-secrets.test.mjs",
    "scripts/prepare-combined-qualified-review.mjs",
    "scripts/prepare-combined-release-preflight.mjs",
    "scripts/prepare-combined-outcome-readiness.mjs",
    "scripts/prepare-ct142-review1.mjs",
    "scripts/prepare-ct143-review.mjs",
    "docs/marketing",
    "docs/operations/creem-billing-runbook.md",
    "docs/operations/hosted-runtime-runbook.md",
    "packages/hosted/tests",
    "scripts/audit-search-indexing.mjs",
    "scripts/tests/analytics-privacy.test.mjs",
    "scripts/tests/public-search.test.mjs",
    "scripts/validate-hosted-environments.mjs"
  ],
  "dependency_inventory": "ops/release/dependency-license-inventory.json",
  "third_party_notices_manifest": "ops/release/third-party-notices.json",
  "testing_result": "docs/product/versions/v0.1.0/40-testing/CT-12/result.json",
  "build_manifest": "ops/release/reproducible-build.json",
  "asset_extensions": [
    ".gif",
    ".ico",
    ".jpeg",
    ".jpg",
    ".png",
    ".svg",
    ".ttf",
    ".webp",
    ".woff",
    ".woff2"
  ],
  "public_copy_roots": [
    "apps/web/index.html",
    "apps/web/hosted.html",
    "apps/web/src",
    "apps/web/public/mcp-guide.html"
  ],
  "ignore_contract": {
    ".gitignore": [".control-tower/", ".env", ".env.*", ".playwright-mcp/", "/backups/"]
  }
}
